# ── App ──────────────────────────────────────────────────────────────
APP_NAME="বাগানবন্ধু"
APP_ENV=local                 # local | staging | production
APP_DEBUG=true                # MUST be false in production
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=bn

# Where a "new contact message" heads-up email goes. Leave blank to skip email
# entirely and rely on the /admin/contact inbox — that's the real source of truth.
SUPPORT_EMAIL=

# 32 random bytes, base64. Generate:
#   php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=
HASH_PEPPER=

# ── Database ─────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gardenbondhu
DB_USER=gb_app
DB_PASS=
DB_CHARSET=utf8mb4

# Migration credentials (server only — the app user has no DDL rights)
DB_MIGRATE_USER=
DB_MIGRATE_PASS=

# ── Carrier billing ──────────────────────────────────────────────────
CARRIER_DRIVER=mock           # mock | carrier   (mock is BLOCKED when APP_ENV=production)
CARRIER_BASE_URL=
CARRIER_APP_ID=
CARRIER_APP_KEY=
CARRIER_APP_SECRET=
CARRIER_PASSWORD=
CARRIER_PRODUCT_ID=
CARRIER_DAILY_AMOUNT=2.78
CARRIER_CURRENCY=BDT
CARRIER_WEBHOOK_SECRET=
CARRIER_WEBHOOK_IPS=          # comma-separated allowlist, empty = signature only
CARRIER_TIMEOUT=15
CARRIER_SHORTCODE=16216
CARRIER_STOP_KEYWORD=STOP

# ── Subscription policy ──────────────────────────────────────────────
SUB_GRACE_HOURS=48
SUB_PERIOD_HOURS=24

# ── OTP ──────────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN=60

# ── Security ─────────────────────────────────────────────────────────
SESSION_LIFETIME_MINUTES=1440
SESSION_ABSOLUTE_DAYS=30
SESSION_COOKIE_NAME=gb_sid
SESSION_SECURE=true           # false only on plain-http localhost
TRUSTED_PROXIES=              # e.g. Cloudflare ranges, else empty
ADMIN_IP_ALLOWLIST=           # comma-separated, empty = disabled

# ── Uploads ──────────────────────────────────────────────────────────
UPLOAD_MAX_BYTES=4194304
UPLOAD_PATH=storage/uploads

# ── Logging & retention (days) ───────────────────────────────────────
LOG_LEVEL=info                # debug | info | warning | error
RETAIN_OTP_HOURS=24
RETAIN_RATELIMIT_DAYS=7
RETAIN_WEBHOOK_DAYS=90
RETAIN_SESSION_DAYS=30
RETAIN_AUDIT_DAYS=365
ANONYMIZE_AFTER_DAYS=180
