# ── App ──────────────────────────────────────────────────────────────
APP_NAME="বাগানবন্ধু"
APP_ENV=local                 # local | staging | production
APP_DEBUG=true                # MUST be false in production
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Dhaka
APP_LOCALE=bn

# Where a "new contact message" heads-up email goes. Leave blank to skip email
# entirely and rely on the /admin/contact inbox — that's the real source of truth.
SUPPORT_EMAIL=

# 32 random bytes, base64. Generate:
#   php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
APP_KEY=
HASH_PEPPER=

# ── Database ─────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gardenbondhu
DB_USER=gb_app
DB_PASS=
DB_CHARSET=utf8mb4

# Migration credentials (server only — the app user has no DDL rights)
DB_MIGRATE_USER=
DB_MIGRATE_PASS=

# ── Security ─────────────────────────────────────────────────────────
SESSION_LIFETIME_MINUTES=1440
SESSION_ABSOLUTE_DAYS=30
SESSION_COOKIE_NAME=gb_sid
SESSION_SECURE=true           # false only on plain-http localhost
TRUSTED_PROXIES=              # e.g. Cloudflare ranges, else empty
ADMIN_IP_ALLOWLIST=           # comma-separated, empty = disabled

# ── Uploads ──────────────────────────────────────────────────────────
UPLOAD_MAX_BYTES=4194304
UPLOAD_PATH=storage/uploads

# ── Logging & retention (days) ───────────────────────────────────────
LOG_LEVEL=info                # debug | info | warning | error
RETAIN_RATELIMIT_DAYS=7
RETAIN_SESSION_DAYS=30
RETAIN_AUDIT_DAYS=365
